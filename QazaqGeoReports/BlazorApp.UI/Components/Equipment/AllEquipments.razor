@page "/Equipment/AllEquipments"
@using QazaqGeoReports.Application.DTOs.EquipmentDtos
@using QazaqGeoReports.Application.Interfaces.Services 
@using QazaqGeoReports.Domain.Common

@inject IEquipmentService EquipmentService

<PageTitle>Оборудование</PageTitle>

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <h2 class="mb-0">📦 Оборудование</h2>

        <a href="/equipment/create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Добавить
        </a>
    </div>

    <!-- Панель фильтров -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <input class="form-control"
                           placeholder="Поиск по названию..."
                           @bind="_search" @bind:event="oninput" />
                </div>

                <div class="col-md-4">
                    <select class="form-select" @bind="_status">
                        <option value="">Все статусы</option>
                        @foreach (var s in _statuses)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>

                <div class="col-md-2 text-end">
                    <button class="btn btn-outline-secondary w-100" @onclick="Load">
                        🔍 Поиск
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Таблица -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Название</th>
                    <th>Инв. №</th>
                    <th>Статус</th>
                    <th style="width:160px;"></th>
                </tr>
            </thead>
            <tbody>

                @if (_items == null)
                {
                    <tr><td colspan="4" class="text-center py-4">Загрузка...</td></tr>
                }
                else if (!_items.Any())
                {
                    <tr><td colspan="4" class="text-center py-4">Нет данных</td></tr>
                }
                else
                {
                    @foreach (var eq in _items)
                    {
                        <tr>
                            <td>@eq.Name</td>
                            <td>@eq.SerialNumber</td>
                            <td>
                                <span class="badge bg-@GetStatusColor(eq.Status)">
                                    @eq.Status
                                </span>
                            </td>
                            <td class="text-end">

                                <a class="btn btn-sm btn-light"
                                   href="/Equipment/Details/@eq.Id">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a class="btn btn-sm btn-primary ms-1"
                                   href="/Equipment/Edit/@eq.Id">
                                    <i class="bi bi-pencil"></i>
                                </a>

                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>
</div>

@code {
    private List<BaseEquipmentDto>? _items;
    private string _search = "";
    private string _status = "";

    private readonly string[] _statuses = Enum.GetNames<EquipmentStatus>();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _items = await EquipmentService.GetAllAsync();
    }

    private string GetStatusColor(string status) =>
        status switch
        {
            "Available" => "success",
            "InUse" => "warning",
            "Broken" => "danger",
            "OnRepair" => "info",
            _ => "secondary"
        };
}
