@page "/Equipment/AllEquipments"
@using QazaqGeoReports.Application.DTOs.EquipmentDtos
@using QazaqGeoReports.Application.Interfaces.Services 
@using QazaqGeoReports.Domain.Common

@inject IEquipmentService EquipmentService

<PageTitle>Оборудование</PageTitle>

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <h2 class="mb-0">📦 Оборудование</h2>

        <a href="/equipment/create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Добавить
        </a>
    </div>

    <!-- Панель фильтров -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <input class="form-control"
                           placeholder="Поиск по названию..."
                           @bind="_search" @bind:event="oninput" />
                </div>

                <div class="col-md-4">
                    <select class="form-select" @bind="_status">
                        <option value="">Все статусы</option>
                        @foreach (var s in _statuses)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>

                <div class="col-md-2 text-end">
                    <button class="btn btn-outline-secondary w-100" @onclick="Load">
                        🔍 Поиск
                    </button>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilters" title="Сбросить фильтры">Сброс</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Таблица -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Название</th>
                    <th>Инв. №</th>
                    <th>Статус</th>
                    <th style="width:160px;"></th>
                </tr>
            </thead>
            <tbody>

                @if (_items == null)
                {
                    <tr><td colspan="4" class="text-center py-4">Загрузка...</td></tr>
                }
                else if (!_items.Any())
                {
                    <tr><td colspan="4" class="text-center py-4">Нет данных</td></tr>
                }
                else
                {
                    @foreach (var eq in _items)
                    {
                        <tr>
                            <td>@eq.Name</td>
                            <td>@eq.SerialNumber</td>
                            <td>
                                <span class="badge bg-@GetStatusColor(eq.Status)">
                                    @eq.Status
                                </span>
                            </td>
                            <td class="text-end">

                                <a class="btn btn-sm btn-light"
                                   href="/Equipment/Details/@eq.Id">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a class="btn btn-sm btn-primary ms-1"
                                   href="/Equipment/Edit/@eq.Id">
                                    <i class="bi bi-pencil"></i>
                                </a>

                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>
</div>

@code {
    private List<BaseEquipmentDto>? _allItems;  // все данные
    private List<BaseEquipmentDto>? _items;     // отфильтрованные

    private string _search = "";
    private string _status = "";

    private readonly string[] _statuses = Enum.GetNames<EquipmentStatus>();

    protected override async Task OnInitializedAsync()
    {
        _allItems = await EquipmentService.GetAllAsync();
        ApplyFilter();
    }

    private async Task Load()
    { 
        ApplyFilter();
    }
    private void ResetFilters()
    {
        _search = "";
        _status = "";

        ApplyFilter();
    }
    private void ApplyFilter()
    {
        if (_allItems is null)
        {
            _items = null;
            return;
        }

        IEnumerable<BaseEquipmentDto> query = _allItems;

        // Поиск по названию и инв. номеру
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();

            query = query.Where(e =>
                (!string.IsNullOrEmpty(e.Name) &&
                 e.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(e.SerialNumber) &&
                 e.SerialNumber.Contains(term, StringComparison.OrdinalIgnoreCase))
            );
        }

        // Фильтр по статусу
        if (!string.IsNullOrWhiteSpace(_status))
        {
            query = query.Where(e => e.Status == _status);
        }

        _items = query.ToList();
    }

    private static readonly HashSet<string> DangerStatuses =
    [
        EquipmentStatus.Damaged.ToString(),
        EquipmentStatus.Lost.ToString(),
    ];
    private static readonly HashSet<string> InfoStatuses =
    [
        EquipmentStatus.UnderMaintenance.ToString(),
        EquipmentStatus.Calibrating.ToString(),
        EquipmentStatus.Repairing.ToString(),
    ];
    private static readonly HashSet<string> WarningStatuses =
    [
        EquipmentStatus.AwaitingReturn.ToString(),
        EquipmentStatus.AwaitingPickup.ToString(),
        EquipmentStatus.InUse.ToString(),
        EquipmentStatus.InTransit.ToString(),
    ];
    private static readonly HashSet<string> SuccessStatuses =
    [
        EquipmentStatus.Available.ToString(),
        EquipmentStatus.FieldReady.ToString(),
    ];
    private string GetStatusColor(string status)
    {
        if (DangerStatuses.Contains(status))
            return "danger";

        if (InfoStatuses.Contains(status))
            return "info";

        if (WarningStatuses.Contains(status))
            return "warning";

        if (SuccessStatuses.Contains(status))
            return "success";

        return "secondary";
    }
}
