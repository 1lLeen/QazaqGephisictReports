@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using QazaqGeoReports.Domain.Entities

@inject SignInManager<User> SignInManager
@inject NavigationManager NavigationManager

<div class="app-shell min-vh-100">
    <header class="app-header sticky-top border-bottom">
        <div class="container py-3 d-flex align-items-center justify-content-between">

            <!-- Brand -->
            <a class="brand d-flex align-items-center gap-2 text-decoration-none" href="/Dashboard">
                <span class="brand-mark">
                    <img src="https://qazaqgeophysics.kz/wp-content/uploads/2023/01/logo-inverse-retina.png"
                         alt="QazaqGeophysics"
                         class="brand-logo" />
                </span>
                <span class="fw-bold fs-5 text-dark">QazaqGeoReports</span>
            </a>


            <!-- Nav -->
            <nav class="d-flex align-items-center gap-2">
                <a class="btn btn-outline-secondary rounded-pill px-3" href="/Dashboard">
                    <i class="bi bi-grid me-2"></i> Dashboard
                </a>

                <a class="btn btn-outline-secondary rounded-pill px-3" href="/Missions/MyMissions">
                    <i class="bi bi-flag me-2"></i> Missions
                </a>

                <!-- Auth -->
                <AuthorizeView>
                    <Authorized Context="auth">
                        @{
                            var name = auth.User?.Identity?.Name ?? "User";
                            var initials = GetInitials(name);
                        }

                        <div class="dropdown">
                            <button class="btn btn-light rounded-pill border px-2 d-flex align-items-center gap-2 shadow-sm"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <span class="avatar">@initials</span>

                                <span class="d-none d-md-inline fw-semibold text-dark">
                                    @name
                                </span>

                                <i class="bi bi-chevron-down text-muted small"></i>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li class="px-3 py-2">
                                    <div class="small text-muted">Signed in as</div>
                                    <div class="fw-semibold">@name</div>
                                </li>
                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <a class="dropdown-item" href="/Account/Manage">
                                        <i class="bi bi-person-gear me-2"></i> Профиль
                                    </a>
                                </li> 
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <div class="nav-item px-3">
                                        <form action="Account/Logout" method="post" class="logout-form">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />

                                            <button type="submit" class="logout-btn">
                                                <i class="bi bi-box-arrow-right me-2"></i>
                                                <span>Выйти</span>
                                            </button>
                                        </form>
                                    </div>
                                </li>

                            </ul>
                        </div>
                    </Authorized>

                    <NotAuthorized>
                        <a class="btn btn-primary rounded-pill px-3" href="/Account/Login">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Войти
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </nav>
        </div>
    </header>

    <!-- Body -->
    <main class="container py-4">
        @Body
    </main>

    <!-- Footer -->
    <footer class="app-footer border-top">
        <div class="container py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="text-muted small">
                © @DateTime.Now.Year QazaqGeoReports
            </div>
            <div class="text-muted small">
                Field reports • Missions • Equipment • Cars
            </div>
        </div>
    </footer>
</div>

@code { 
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
    private async Task Logout()
    {
        await SignInManager.SignOutAsync();
         
        NavigationManager.NavigateTo("/Account/Login");
    }
    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U"; 
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpperInvariant();
        return (parts[0].Substring(0, 1) + parts[1].Substring(0, 1)).ToUpperInvariant();
    }
}
