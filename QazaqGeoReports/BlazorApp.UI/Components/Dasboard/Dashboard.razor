@page "/Dashboard"
@attribute [Authorize(Roles = "Admin,General,Supervisor,Driver,Worker")]

@using Microsoft.AspNetCore.Authorization
@using QazaqGeoReports.Application.Interfaces.Services
@using System.Security.Claims

@inject IDashboardService DashboardService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard</PageTitle>

<div class="container py-3">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-1 fw-bold">📊 Dashboard</h2>
            <div class="text-muted small">Всё управление проектом — здесь.</div>
        </div>

        <div class="d-flex gap-2"> 
            @if (CanCreateReport)
            {
                <a class="btn btn-primary rounded-pill px-3" href="/reports/create">
                    <i class="bi bi-plus-circle me-2"></i> Новый отчёт
                </a>
            }
             
            @if (CanManageAll)
            {
                <a class="btn btn-outline-secondary rounded-pill px-3" href="/missions/create">
                    <i class="bi bi-flag me-2"></i> Новая миссия
                </a>
            }
        </div>
    </div>

    <!-- Навигация плитками -->
    <div class="row g-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="fw-bold">🧭 Разделы</div>
                    <div class="text-muted small">Нажал — и ты там.</div>

                    <div class="row g-3 mt-1">
                         
                        @if (CanSeeReports)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <NavTile Title="Отчёты" Subtitle="Список, фильтры, проблемные"
                                         Icon="bi-file-earmark-text" Href="/Report/AllReports" ImgHref="/imgs/report.png" />
                            </div>
                        }
                         
                        @if (CanManageAll)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <NavTile Title="Оборудование" Subtitle="Снаряга, статусы, ремонт"
                                         Icon="bi-box-seam" Href="/Equipment/AllEquipments" ImgHref="/imgs/equipment.png" />
                            </div>
                        }
                         
                        @if (CanManageAll)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <NavTile Title="Фото" Subtitle="Галерея: отчёты/машины/оборудование"
                                         Icon="bi-images" Href="/Images" ImgHref="/imgs/photo.png" />
                            </div>
                        }
                         
                        @if (CanSeeMissions)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <NavTile Title="Миссии" Subtitle="Активные, завершённые, сроки"
                                         Icon="bi-compass" Href="/Missions" ImgHref="/imgs/mission.png" />
                            </div>
                        } 

                        @if (CanSeeCars)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <NavTile Title="Машины" Subtitle="Транспорт, состояния, привязки"
                                         Icon="bi-truck" Href="/cars" ImgHref="/imgs/cars.png" />
                            </div>
                        }
                         
                        @if (CanManageAll)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <NavTile Title="Пользователи" Subtitle="Роли, доступ, активность"
                                         Icon="bi-people" Href="/users" ImgHref="/imgs/users.png" />
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@code {
    private ClaimsPrincipal? _user;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = state.User;
    }
     
    private bool IsAdmin => _user?.IsInRole("Admin") == true;
    private bool IsGeneral => _user?.IsInRole("General") == true || _user?.IsInRole("Genaral") == true; 
    private bool IsSupervisor => _user?.IsInRole("Supervisor") == true;
    private bool IsDriver => _user?.IsInRole("Driver") == true;
    private bool IsWorker => _user?.IsInRole("Worker") == true;
     
    private bool CanManageAll => IsAdmin || IsGeneral || IsSupervisor;

    private bool CanSeeReports => CanManageAll || IsDriver || IsWorker;
    private bool CanSeeMissions => CanManageAll || IsDriver || IsWorker;
    private bool CanCreateReport => CanManageAll || IsDriver;  
    private bool CanSeeCars => CanManageAll || IsDriver;      
}