@page "/Dashboard"
@using QazaqGeoReports.Application.Interfaces.Services
@inject IDashboardService DashboardService

<PageTitle>Dashboard</PageTitle>

<div class="container py-3">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-1 fw-bold">📊 Dashboard</h2>
            <div class="text-muted small">Всё управление проектом — здесь.</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-primary rounded-pill px-3" href="/reports/create">
                <i class="bi bi-plus-circle me-2"></i> Новый отчёт
            </a>
            <a class="btn btn-outline-secondary rounded-pill px-3" href="/missions/create">
                <i class="bi bi-flag me-2"></i> Новая миссия
            </a>
        </div>
    </div>

    <!-- Навигация плитками -->
    <div class="row g-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="fw-bold">🧭 Разделы</div>
                    <div class="text-muted small">Нажал — и ты там.</div>

                    <div class="row g-3 mt-1"> 
                        <div class="col-12 col-md-6 col-xl-4">
                            <NavTile Title="Отчёты" Subtitle="Список, фильтры, проблемные"
                                     Icon="bi-file-earmark-text" Href="/Report/AllReports" ImgHref="/imgs/report.png"/>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <NavTile Title="Оборудование" Subtitle="Снаряга, статусы, ремонт"
                                     Icon="bi-box-seam" Href="/Equipment/AllEquipments" ImgHref="/imgs/equipment.png/" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <NavTile Title="Фото" Subtitle="Галерея: отчёты/машины/оборудование"
                                     Icon="bi-images" Href="/Images" ImgHref="/imgs/photo.png"/>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <NavTile Title="Миссии" Subtitle="Активные, завершённые, сроки"
                                     Icon="bi-compass" Href="/missions" ImgHref="/imgs/mission.png"/>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <NavTile Title="Машины" Subtitle="Транспорт, состояния, привязки"
                                     Icon="bi-truck" Href="/cars" ImgHref="/imgs/cars.png" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <NavTile Title="Пользователи" Subtitle="Роли, доступ, активность"
                                     Icon="bi-people" Href="/users" ImgHref="/imgs/users.png" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
