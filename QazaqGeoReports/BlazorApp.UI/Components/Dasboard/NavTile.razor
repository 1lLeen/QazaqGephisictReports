<a href="@Href" class="text-decoration-none">
    <div class="card border-0 shadow-sm h-100 rounded-4 tile">
        <div class="card-body d-flex gap-3 align-items-start">
            <div class="icon rounded-4 d-flex align-items-center justify-content-center">
                <img class="icon bi @Icon fs-4" src="@ImgHref">
            </div>

            <div class="flex-grow-1">
                <div class="fw-bold">@Title</div>
                <div class="text-muted small">@Subtitle</div>

                @if (!string.IsNullOrWhiteSpace(Badge))
                {
                    <div class="mt-2">
                        <span class="badge rounded-pill @BadgeClass px-3 py-2">@Badge</span>
                    </div>
                }
            </div>

            <i class="bi bi-chevron-right text-muted"></i>
        </div>
    </div>
</a>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "bi-grid";
    [Parameter] public string Href { get; set; } = "#";
    [Parameter] public string? ImgHref { get; set; } 
    [Parameter] public string? Badge { get; set; }
    [Parameter] public string Tone { get; set; } = "info"; // good | info | warn | bad

    private string BadgeClass => Tone switch
    {
        "good" => "text-bg-success",
        "warn" => "text-bg-warning",
        "bad" => "text-bg-danger",
        _ => "text-bg-primary"
    };
}

<style>
    .tile {
        transition: transform .12s ease, box-shadow .12s ease;
        cursor: pointer;
    }

    .tile:hover {
        transform: translateY(-2px);
        box-shadow: 0 1rem 2rem rgba(0,0,0,.08) !important;
    }

    .icon {
        width: 56px;
        height: 56px;
        /* background: rgba(0,0,0,.04); */
    }
</style>
