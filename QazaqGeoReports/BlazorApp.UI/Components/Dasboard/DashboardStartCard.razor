@inherits LayoutComponentBase

<a href="@Link" class="text-decoration-none">
    <div class="card border-0 shadow-sm h-100 stat-card @ToneClass">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div>
                    <div class="text-muted small">@Title</div>
                    <div class="display-6 fw-bold mb-0">@Value</div>
                </div>

                <div class="stat-icon rounded-4 d-flex align-items-center justify-content-center">
                    <i class="bi @Icon fs-4"></i>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <div class="mt-2">
                    <span class="badge rounded-pill @BadgeClass px-3 py-2">
                        @Subtitle
                    </span>
                </div>
            }

            <div class="mt-3 small text-muted d-flex align-items-center gap-2">
                <i class="bi bi-arrow-right"></i>
                Открыть детали
            </div>
        </div>
    </div>
</a>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "bi-grid";
    [Parameter] public int Value { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Tone { get; set; } = "info"; // good | info | warn | bad
    [Parameter] public string Link { get; set; } = "#";

    private string ToneClass => Tone switch
    {
        "good" => "tone-good",
        "warn" => "tone-warn",
        "bad" => "tone-bad",
        _ => "tone-info"
    };

    private string BadgeClass => Tone switch
    {
        "good" => "text-bg-success",
        "warn" => "text-bg-warning",
        "bad" => "text-bg-danger",
        _ => "text-bg-primary"
    };
}

<style>
    .stat-card{
        border-radius: 1.25rem;
        transition: transform .12s ease, box-shadow .12s ease;
        overflow: hidden;
        position: relative;
    }
    .stat-card:hover{
        transform: translateY(-2px);
        box-shadow: 0 1rem 2rem rgba(0,0,0,.08) !important;
    }
    .stat-icon{
        width: 48px;
        height: 48px;
        background: rgba(0,0,0,.04);
    }

    /* Tone strips */
    .tone-info::before,
    .tone-good::before,
    .tone-warn::before,
    .tone-bad::before{
        content:"";
        position:absolute;
        left:0; top:0; bottom:0;
        width:6px;
        opacity:.9;
    }
    .tone-info::before{ background: #0d6efd; }
    .tone-good::before{ background: #198754; }
    .tone-warn::before{ background: #ffc107; }
    .tone-bad::before{ background: #dc3545; }
</style>
