@page "/Missions/Edit/{MissionId:int}"
@attribute [Authorize(Roles = "Admin,General,Supervisor")]

@using QazaqGeoReports.Application.DTOs.MissionDtos
@using QazaqGeoReports.Application.DTOs.UserDtos
@using QazaqGeoReports.Application.Interfaces.Services
@using QazaqGeoReports.Domain.Common
@using System.ComponentModel.DataAnnotations
 

@inject NavigationManager Nav
 
@inject IMissionService MissionService
@inject IUserService UserService

<PageTitle>Редактирование миссии</PageTitle>

<div class="container py-4 edit-mission">
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-outline-secondary btn-sm rounded-pill" href="/Missions">
                    <i class="bi bi-arrow-left me-1"></i> Назад
                </a>
                <span class="badge text-bg-light border">Mission #@MissionId</span>
            </div>
            <h3 class="mt-2 mb-0">Редактировать миссию</h3>
            <div class="text-muted small">Обнови данные и нажми “Сохранить”.</div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary rounded-pill" type="button" @onclick="Cancel" disabled="@(_isSaving || _isLoading)">
                Отмена
            </button>
            <button class="btn btn-primary rounded-pill" type="button" @onclick="SubmitFromButton" disabled="@(_isSaving || _isLoading || !_isReady)">
                @if (_isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true">Сохранение...</span>
                    
                                }
                else
                {
                    <i class="bi bi-check2-circle me-2">Сохранить</i>
                    
                                }
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <div class="spinner-border" role="status"></div>
                <div class="text-muted mt-2">Загружаю миссию...</div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger border-0 shadow-sm">
            <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle me-2"></i>Не удалось загрузить миссию</div>
            <div class="small">@_loadError</div>
        </div>
    }
    else
    {
        <EditForm EditContext="@_editContext" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger small mb-3" />

            @if (!string.IsNullOrWhiteSpace(_saveError))
            {
                <div class="alert alert-warning border-0 shadow-sm">
                    <div class="fw-semibold mb-1"><i class="bi bi-info-circle me-2"></i>Не получилось сохранить</div>
                    <div class="small">@_saveError</div>
                </div>
            }

            <div class="row g-3">
                <div class="col-12 col-lg-8">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="icon-bubble">
                                        <i class="bi bi-flag"></i>
                                    </span>
                                    <div>
                                        <div class="fw-semibold">Основное</div>
                                        <div class="text-muted small">Название, описание и статус</div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Название <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-lg" @bind-Value="_model.Title" placeholder="Напр.: Полевые работы — Жезказган" />
                                <ValidationMessage For="@(() => _model.Title)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Описание</label>
                                <InputTextArea class="form-control" @bind-Value="_model.Description" rows="4" placeholder="Коротко: что делаем, где, для кого…" />
                                <div class="form-hint">Не обязательно. Но супервайзер будет счастлив 😄</div>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Статус</label>
                                    <InputSelect class="form-select" @bind-Value="_model.Status">
                                        @foreach (var s in _statuses)
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label">Супервайзер</label>
                                    <InputSelect class="form-select" @bind-Value="_model.SupervisorId">
                                        <option value="">— Не выбран —</option>
                                        @foreach (var u in _supervisors)
                                        {
                                            <option value="@u.Id">@u.DisplayName</option>
                                        }
                                    </InputSelect>
                                    <div class="form-hint">Список — из пользователей роли Supervisor (или как ты фильтруешь).</div>
                                </div>
                            </div>
                            <div class="dm-meta worker-picker">
                                <div class="dm-meta-label d-flex align-items-center justify-content-between">
                                    <span>Workers</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge text-bg-light border">@_selectedWorkers.Count</span>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary rounded-pill"
                                                disabled="@(_selectedWorkers.Count == 0)"
                                                @onclick="ClearWorkers">
                                            <i class="bi bi-trash3 me-1"></i> Очистить
                                        </button>
                                    </div>
                                </div>

                                <div class="row g-2 mt-1">
                                    <div class="col-md-6">
                                        <label class="form-label">Добавить работника</label>

                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-search"></i></span>

                                            <InputText class="form-control"
                                                       @bind-Value="_workerSearch"
                                                       @bind-Value:event="oninput"
                                                       placeholder="Начни вводить имя..."
                                                       @onkeydown="OnWorkerSearchKeyDown" />

                                            <button class="btn btn-outline-secondary"
                                                    type="button"
                                                    title="Очистить поиск"
                                                    disabled="@string.IsNullOrWhiteSpace(_workerSearch)"
                                                    @onclick="() => _workerSearch = string.Empty">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>

                                        <div class="list-group mt-2 worker-list">
                                            @if (FilteredAvailableWorkers.Count == 0)
                                            {
                                                <div class="p-2 text-muted small">
                                                    Ничего не найдено.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var u in FilteredAvailableWorkers)
                                                {
                                                    <button type="button"
                                                            class="list-group-item list-group-item-action d-flex align-items-center justify-content-between"
                                                            @onclick="() => AddWorker(u.User.Id)">
                                                        <span class="text-truncate">
                                                            <i class="bi bi-person me-2"></i>@u.FullName
                                                        </span>
                                                        <span class="badge text-bg-secondary">+</span>
                                                    </button>
                                                }
                                            }
                                        </div>

                                        <div class="form-text">
                                            Клик — добавил. Enter — добавит первый результат.
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Выбрано</label>

                                        @if (_selectedWorkers.Count == 0)
                                        {
                                            <div class="text-muted fst-italic">Пусто.</div>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-wrap gap-2 worker-chips">
                                                @foreach (var w in _selectedWorkers.OrderBy(x => x.FullName))
                                                {
                                                    <span class="badge rounded-pill text-bg-light border d-inline-flex align-items-center gap-2">
                                                        <i class="bi bi-person"></i>
                                                        <span class="text-truncate">@w.FullName</span>

                                                        <button type="button"
                                                                class="btn btn-sm btn-link text-danger p-0"
                                                                title="Убрать"
                                                                @onclick="() => RemoveWorker(w.User.Id)">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                    </span>
                                                }
                                            </div>
                                        }

                                    </div>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Дата начала</label>
                                    <InputDate class="form-control" @bind-Value="_model.StartDate" />
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label">Дата окончания</label>
                                    <InputDate class="form-control" @bind-Value="_model.EndDate" />
                                    <ValidationMessage For="@(() => _model.EndDate)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between mt-4">
                                <div class="text-muted small">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Данные сохраняются без “магии”: только то, что ты изменил.
                                </div>

                                <button type="submit" class="btn btn-primary rounded-pill" disabled="@(_isSaving || !_isReady)">
                                    @if (_isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true">Сохранение...</span>
                                        
                                                                }
                                    else
                                    {
                                        <i class="bi bi-save2 me-2">Сохранить</i>
                                        
                                                                }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="icon-bubble subtle">
                                    <i class="bi bi-info-circle"></i>
                                </span>
                                <div class="fw-semibold">Подсказки</div>
                            </div>

                            <ul class="small text-muted mb-0 ps-3">
                                <li>Название — обязательное.</li>
                                <li>Если дата окончания раньше даты начала — форма ругнётся.</li>
                                <li>Супервайзер можно не ставить, если у тебя это допускается.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm mt-3">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="icon-bubble subtle">
                                    <i class="bi bi-lightning-charge"></i>
                                </span>
                                <div class="fw-semibold">Быстрые действия</div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-outline-secondary rounded-pill" @onclick="ResetToLoaded" disabled="@(_isSaving || _isLoading)">
                                    <i class="bi bi-arrow-counterclockwise me-2"></i> Откатить изменения
                                </button>

                                <button type="button" class="btn btn-outline-danger rounded-pill" @onclick="Cancel" disabled="@(_isSaving || _isLoading)">
                                    <i class="bi bi-x-circle me-2"></i> Выйти без сохранения
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int MissionId { get; set; }

    private MissionFormModel _model = new();
    private MissionFormModel _loadedSnapshot = new();

    private EditContext? _editContext;

    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _loadError;
    private string? _saveError;

    private List<MissionStatus> _statuses = new();
    private List<UserOption> _supervisors = new();

    private bool _isReady => _editContext is not null;

    private List<UserViewModel> _allWorkers = new(); 

    private List<UserViewModel> _selectedWorkers = new();

    private List<UserViewModel> _availableWorkers = new();
    private string _workerSearch = string.Empty;
     
    private List<UserViewModel> FilteredAvailableWorkers =>
        string.IsNullOrWhiteSpace(_workerSearch)
            ? _availableWorkers.Take(50).ToList()
            : _availableWorkers
                .Where(u =>
                    (u.FullName?.Contains(_workerSearch, StringComparison.OrdinalIgnoreCase) ?? false) || 
                    (u.User?.Email?.Contains(_workerSearch, StringComparison.OrdinalIgnoreCase) ?? false))
                .Take(50)
                .ToList();

    private void AddWorker(string id)
    {
        if (string.IsNullOrWhiteSpace(id)) return;

        if (_selectedWorkers.Any(x => x.User.Id.Equals(id, StringComparison.OrdinalIgnoreCase)))
            return;

        var user = _allWorkers.FirstOrDefault(x => x.User.Id.Equals(id, StringComparison.OrdinalIgnoreCase));
        if (user is null) return;

        _selectedWorkers.Add(user);
        _workerSearch = string.Empty;      
        RebuildAvailable();
    }

    private void ClearWorkers()
    {
        _selectedWorkers.Clear();
        _workerSearch = string.Empty;
        RebuildAvailable();
    }

    private void OnWorkerSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var first = FilteredAvailableWorkers.FirstOrDefault();
            if (first is not null)
                AddWorker(first.User.Id);
        }
    }
    private HashSet<string> ParseWorkers(string? csv)
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(csv))
            return set;
        var parts = csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var p in parts)
        {
            set.Add(p);
        }
        return set;
    }
    private void RebuildAvailable()
    {
        var selectedIds = _selectedWorkers.Select(x => x.User.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _availableWorkers = _allWorkers
            .Where(u => !selectedIds.Contains(u.User.Id))
            .OrderBy(u => u.FullName)
            .ToList();
    }
    private string WorkersCsv => string.Join(",", _selectedWorkers.Select(x => x.User.Id));

    protected override async Task OnInitializedAsync()
    {
        _statuses = Enum.GetValues(typeof(MissionStatus)).Cast<MissionStatus>().ToList();

        try
        {
            _isLoading = true;
            _loadError = null;

            var mission = await MissionService.GetByIdAsync(MissionId);

            _supervisors = (await UserService.GetUsersByRoleAsync(Roles.Supervisor))
                .Select(x => new UserOption(x.User.Id, $"{x.FullName ?? x.UserName ?? x.User.Email}".Trim()))
                .ToList();

            _model = new MissionFormModel
            {
                Id = mission.Id,
                Title = mission.Title,
                Description = mission.Description,
                Status = mission.Status,
                StartDate = mission.StartDate,
                EndDate = mission.EndDate,
                SupervisorId = mission.SupervisorId
            };

            _loadedSnapshot = _model.Clone();

            _editContext = new EditContext(_model);
            _editContext.OnFieldChanged += (_, __) => _saveError = null;

            _allWorkers = (await UserService.GetUsersByRoleAsync(Roles.Worker)); 
             
            var selectedIds = ParseWorkers(mission.Workers);
             
            _selectedWorkers = _allWorkers

                .Where(u => selectedIds.Contains(u.User.Id, StringComparer.OrdinalIgnoreCase))
                .ToList();

            RebuildAvailable();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
    private void OnPickWorker(ChangeEventArgs e)
    {
        var pickedId = e?.Value?.ToString();
        if (string.IsNullOrWhiteSpace(pickedId))
            return;
             
        if (_selectedWorkers.Any(x => x.User.Id.Equals(pickedId, StringComparison.OrdinalIgnoreCase)))
            return;

        var user = _allWorkers.FirstOrDefault(x => x.User.Id.Equals(pickedId, StringComparison.OrdinalIgnoreCase));
        if (user is null)
            return;

        _selectedWorkers.Add(user);
        RebuildAvailable();
    }

    private void RemoveWorker(string id)
    {
        _selectedWorkers.RemoveAll(x => x.User.Id.Equals(id, StringComparison.OrdinalIgnoreCase));
        RebuildAvailable();
    }

    private async Task SaveAsync()
    {
        if (_editContext is null) return;

        _saveError = null;
        _isSaving = true;

        try
        { 

            var dto = new UpdateMissionDto
            {
                Id = MissionId,
                Title = _model.Title,
                Description = _model.Description,
                Status = _model.Status,
                StartDate = ToUtcFromInput(_model.StartDate),
                EndDate = ToUtcFromInput(_model.EndDate),
                SupervisorId = _model.SupervisorId,
                Workers = WorkersCsv
            };

            await MissionService.UpdateAsync(dto, MissionId);

            _loadedSnapshot = _model.Clone();
             
            Nav.NavigateTo($"/Missions/Details/{MissionId}");
        }
        catch (Exception ex)
        {
            _saveError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SubmitFromButton()
    { 
        if (_editContext is null) return;
         
        var valid = _editContext.Validate();
        if (valid)
            await SaveAsync();
    }

    private void ResetToLoaded()
    { 
        _model.Title = _loadedSnapshot.Title;
        _model.Description = _loadedSnapshot.Description;
        _model.Status = _loadedSnapshot.Status;
        _model.StartDate = _loadedSnapshot.StartDate;
        _model.EndDate = _loadedSnapshot.EndDate;
        _model.SupervisorId = _loadedSnapshot.SupervisorId;

        _editContext?.Validate();
    }
    private static DateTime? ToUtcFromInput(DateTime? dt)
    {
        if (dt is null) return null;

        var local = DateTime.SpecifyKind(dt.Value, DateTimeKind.Local);
        return local.ToUniversalTime();
    }
    private void Cancel() => Nav.NavigateTo("/Missions");

    // ====== Form model ======
    public class MissionFormModel
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Название обязательно.")]
        [StringLength(120, ErrorMessage = "Слишком длинно (макс. 120 символов).")]
        public string Title { get; set; } = string.Empty;

        [StringLength(2000, ErrorMessage = "Описание слишком длинное (макс. 2000 символов).")]
        public string? Description { get; set; }

        public MissionStatus Status { get; set; } = MissionStatus.Planned;

        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }

        public string? SupervisorId { get; set; }

        [CustomValidation(typeof(MissionFormModel), nameof(ValidateDates))]
        public DateTime? EndDateForValidation => EndDate;

        public static ValidationResult? ValidateDates(DateTime? _, ValidationContext ctx)
        {
            var m = (MissionFormModel)ctx.ObjectInstance;

            if (m.StartDate.HasValue && m.EndDate.HasValue && m.EndDate.Value.Date < m.StartDate.Value.Date)
                return new ValidationResult("Дата окончания не может быть раньше даты начала.");

            return ValidationResult.Success;
        }

        public MissionFormModel Clone() => new()
        {
            Id = Id,
            Title = Title,
            Description = Description,
            Status = Status,
            StartDate = StartDate,
            EndDate = EndDate,
            SupervisorId = SupervisorId
        };
    }

    public record UserOption(string Id, string DisplayName);
}
