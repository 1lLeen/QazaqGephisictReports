@page "/Missions/MyMissions"
@attribute [Authorize]

@using QazaqGeoReports.Application.DTOs.MissionDtos
@using QazaqGeoReports.Application.Interfaces.Services
@using QazaqGeoReports.Domain.Common
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims

@inject IMissionService MissionService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
<PageTitle>Мои миссии</PageTitle>

<div class="container py-4 mym-page">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-1 fw-bold">🎯 Мои миссии</h2>
            <div class="text-muted small">Твои миссии — в одном месте. Без боли, только контроль.</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-primary rounded-pill px-3" href="/missions/create">
                <i class="bi bi-plus-circle me-2"></i>Создать
            </a>
            <button class="btn btn-outline-secondary rounded-pill px-3" @onclick="Reload" disabled="@_loading">
                <i class="bi bi-arrow-clockwise me-2"></i>Обновить
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger d-flex align-items-start gap-2">
            <i class="bi bi-exclamation-triangle"></i>
            <div>@_error</div>
        </div>
    }

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-3 mym-filters">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-lg-5">
                    <label class="form-label mb-1">Поиск</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control"
                               placeholder="Название / описание / супервайзер..."
                               @bind="_search" @bind:event="oninput" />
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch" title="Очистить">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label mb-1">Статус</label>
                    <select class="form-select" @bind="_status">
                        <option value="">Все</option>
                        @foreach (var s in _statuses)
                        {
                            <option value="@s.Value">@s.Text</option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label mb-1">Сортировка</label>
                    <select class="form-select" @bind="_sort">
                        <option value="new">Сначала новые</option>
                        <option value="old">Сначала старые</option>
                        <option value="title">По названию</option>
                        <option value="status">По статусу</option>
                    </select>
                </div>

                <div class="col-lg-2">
                    <label class="form-label mb-1">Показывать</label>
                    <select class="form-select" @bind="_pageSize">
                        <option value="6">6</option>
                        <option value="9">9</option>
                        <option value="12">12</option>
                        <option value="18">18</option>
                    </select>
                </div>

                <div class="col-12 d-flex flex-wrap gap-2 pt-1">
                    <div class="text-muted small">
                        Всего: <span class="fw-semibold">@FilteredCount</span>
                        @if (_missions.Count > 0)
                        {
                            <span> • Страница: <span class="fw-semibold">@_page</span>/<span class="fw-semibold">@TotalPages</span></span>
                        }
                    </div>

                    <div class="ms-auto d-flex gap-2">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill"
                                @onclick="PrevPage"
                                disabled="@(_page <= 1)">
                            <i class="bi bi-chevron-left me-1"></i>Назад
                        </button>

                        <button class="btn btn-outline-secondary btn-sm rounded-pill"
                                @onclick="NextPage"
                                disabled="@(_page >= TotalPages)">
                            Вперёд<i class="bi bi-chevron-right ms-1"></i>
                        </button>

                        <button class="btn btn-outline-danger btn-sm rounded-pill"
                                @onclick="ResetFilters"
                                disabled="@(!HasAnyFilter)">
                            <i class="bi bi-eraser me-1"></i>Сбросить
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-2">
                <div class="spinner-border" role="status" aria-label="Loading"></div>
                <div class="text-muted">Загружаю миссии...</div>
            </div>
        </div>
    }
    else if (_missions.Count == 0)
    {
        <div class="card border-0 shadow-sm mym-empty">
            <div class="card-body text-center py-5">
                <div class="display-6">🫥</div>
                <h5 class="mt-2 mb-1">Пока нет миссий</h5>
                <div class="text-muted mb-3">Создай первую — и пусть система начнёт приносить пользу.</div>
                <a class="btn btn-primary rounded-pill px-4" href="/missions/create">
                    <i class="bi bi-plus-circle me-2"></i>Создать миссию
                </a>
            </div>
        </div>
    }
    else if (Paged.Count == 0)
    {
        <div class="card border-0 shadow-sm mym-empty">
            <div class="card-body text-center py-5">
                <div class="display-6">🔍</div>
                <h5 class="mt-2 mb-1">Ничего не нашлось</h5>
                <div class="text-muted mb-3">Попробуй убрать фильтры или изменить поиск.</div>
                <button class="btn btn-outline-danger rounded-pill px-4" @onclick="ResetFilters">
                    <i class="bi bi-eraser me-2"></i>Сбросить фильтры
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var m in Paged)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100 mym-card">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between gap-2">
                                <div class="mym-title fw-semibold text-truncate" title="@m.Title">
                                    @m.Title
                                </div>

                                <span class="badge rounded-pill @GetStatusBadge(m.Status)">
                                    @GetStatusText(m.Status)
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(m.Description))
                            {
                                <div class="text-muted small mt-2 mym-desc">
                                    @m.Description
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small mt-2 fst-italic">Описание не задано.</div>
                            }

                            <div class="mt-3 mym-meta small text-muted">
                                <div class="d-flex gap-2 align-items-center">
                                    <i class="bi bi-calendar3"></i>
                                    <span>
                                        @FormatDate(m.StartDate) — @FormatDate(m.EndDate)
                                    </span>
                                </div>
                                @if(m.Supervisor is not null)
                                {
                                    @if (!string.IsNullOrWhiteSpace(m.Supervisor.ViewFullName))
                                    {
                                        <div class="d-flex gap-2 align-items-center mt-1">
                                            <i class="bi bi-person-badge"></i>
                                            <span class="text-truncate" title="@m.Supervisor.FullName">@m.Supervisor.FullName</span>
                                        </div>
                                    }
                                }
                                
                            </div>

                            <div class="mt-auto pt-3 d-flex flex-wrap gap-2">
                                <button class="btn btn-outline-primary btn-sm rounded-pill"
                                        @onclick="() => OpenDetails(m.Id)">
                                    <i class="bi bi-eye me-1"></i>Открыть
                                </button>

                                <button class="btn btn-outline-secondary btn-sm rounded-pill"
                                        @onclick="() => OpenEdit(m.Id)">
                                    <i class="bi bi-pencil-square me-1"></i>Редактировать
                                </button>

                                <span class="ms-auto badge text-bg-light border rounded-pill">
                                    #@m.Id
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination footer -->
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted small">
                Показано: <span class="fw-semibold">@Paged.Count</span> из <span class="fw-semibold">@FilteredCount</span>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm rounded-pill"
                        @onclick="PrevPage"
                        disabled="@(_page <= 1)">
                    <i class="bi bi-chevron-left me-1"></i>Назад
                </button>

                <button class="btn btn-outline-secondary btn-sm rounded-pill"
                        @onclick="NextPage"
                        disabled="@(_page >= TotalPages)">
                    Вперёд<i class="bi bi-chevron-right ms-1"></i>
                </button>
            </div>
        </div>
    }

</div>

@code {
    private string? _currentUserId;
    private bool _loading = true;
    private string? _error;

    private List<BaseMissionDto> _missions = new();

    // Filters
    private string _search = "";
    private string _status = "";
    private string _sort = "new";
    private int _page = 1;
    private int _pageSize = 9;
     
    private readonly List<(string Value, string Text)> _statuses = new()
    {
        ("Planned", "Planned / План"),
        ("InProgress", "InProgress / В работе"),
        ("Completed", "Completed / Завершена"),
        ("Canceled", "Canceled / Отменена"),
    };

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _error = null;

        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;

            _currentUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);

            if (string.IsNullOrWhiteSpace(_currentUserId))
            {
                _missions = new();
                _error = "Не удалось определить текущего пользователя (NameIdentifier claim пуст).";
                return;
            }
             
            _missions = await MissionService.GetMissionsByUserIdAsync(_currentUserId);
        }
        catch (Exception ex)
        {
            _error = $"Ошибка загрузки миссий: {ex.Message}";
        }
        finally
        {
            _loading = false;
            ClampPage();
        }
    }

    private async Task Reload()
    {
        _page = 1;
        await Load();
    }

    private void OpenDetails(int id) => Nav.NavigateTo($"/Missions/Details/{id}");
    private void OpenEdit(int id) => Nav.NavigateTo($"/Missions/Edit/{id}");

    private void ClearSearch()
    {
        _search = "";
        _page = 1;
    }

    private void ResetFilters()
    {
        _search = "";
        _status = "";
        _sort = "new";
        _page = 1;
        _pageSize = 9;
    }

    private bool HasAnyFilter =>
        !string.IsNullOrWhiteSpace(_search) ||
        !string.IsNullOrWhiteSpace(_status) ||
        _sort != "new" ||
        _pageSize != 9;

    // Computed
    private IEnumerable<BaseMissionDto> Filtered
    {
        get
        {
            IEnumerable<BaseMissionDto> q = _missions;

            // Search
            var s = _search?.Trim();
            if (!string.IsNullOrWhiteSpace(s))
            {
                q = q.Where(x =>
                    (x.Title ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (x.Description ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (x.Supervisor.FullName ?? "").Contains(s, StringComparison.OrdinalIgnoreCase)
                );
            }
             
            if (!string.IsNullOrWhiteSpace(_status))
            {
                q = q.Where(x => (x.Status.ToString() ?? "").Equals(_status, StringComparison.OrdinalIgnoreCase));
            }

            // Sort
            q = _sort switch
            {
                "old" => q.OrderBy(x => x.StartDate ?? DateTime.MinValue),
                "title" => q.OrderBy(x => x.Title),
                "status" => q.OrderBy(x => x.Status.ToString()),
                _ => q.OrderByDescending(x => x.StartDate ?? DateTime.MinValue)
            };

            return q;
        }
    }

    private int FilteredCount => Filtered.Count();

    private int TotalPages
    {
        get
        {
            if (FilteredCount == 0) return 1;
            var pages = (int)Math.Ceiling(FilteredCount / (double)_pageSize);
            return Math.Max(1, pages);
        }
    }

    private List<BaseMissionDto> Paged
        => Filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    private void NextPage()
    {
        if (_page < TotalPages) _page++;
    }

    private void PrevPage()
    {
        if (_page > 1) _page--;
    }

    private void ClampPage()
    {
        if (_page < 1) _page = 1;
        if (_page > TotalPages) _page = TotalPages;
    }

    private static string FormatDate(DateTime? dt)
        => dt is null ? "—" : dt.Value.ToString("dd.MM.yyyy");

    private static string GetStatusText(object? status)
        => status?.ToString() ?? "Unknown";

    private static string GetStatusBadge(object? status)
    {
        var s = status?.ToString() ?? "";
        return s switch
        {
            "Planned" => "text-bg-secondary",
            "InProgress" => "text-bg-primary",
            "Completed" => "text-bg-success",
            "Canceled" => "text-bg-danger",
            _ => "text-bg-dark"
        };
    }
}
