@page "/Missions"
@attribute [Authorize(Roles = "Admin,General,Supervisor")]

@using Microsoft.AspNetCore.Authorization
@using QazaqGeoReports.Application.DTOs.MissionDtos
@using QazaqGeoReports.Application.Interfaces.Services
@using QazaqGeoReports.Domain.Common
@inject NavigationManager Nav
@inject IMissionService MissionService

<PageTitle>Missions</PageTitle>

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div>
            <div class="text-secondary small">QazaqGeoReports • Missions</div>
            <h3 class="mb-1">All Missions</h3>
            <div class="text-secondary">Список миссий: ищи, фильтруй, открывай.</div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="Reload" disabled="@IsBusy" title="Обновить">
                <i class="bi bi-arrow-clockwise me-1"></i> Обновить
            </button>
            <button class="btn btn-primary" @onclick="Create" title="Создать миссию">
                <i class="bi bi-plus-lg me-1"></i> New mission
            </button>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">

                <div class="col-12 col-lg-5">
                    <label class="form-label mb-1">Поиск</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control"
                               placeholder="Название, описание, супервайзер…"
                               @bind="Query"
                               @bind:event="oninput" />
                        @if (!string.IsNullOrWhiteSpace(Query))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch" title="Очистить">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label mb-1">Статус</label>
                    <select class="form-select" @bind="StatusFilter">
                        <option value="">Все статусы</option>
                        @foreach (var s in Enum.GetValues<MissionStatus>())
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label mb-1">Сортировка</label>
                    <select class="form-select" @bind="Sort">
                        <option value="@SortMode.UpdatedDesc">Обновлено ↓</option>
                        <option value="@SortMode.UpdatedAsc">Обновлено ↑</option>
                        <option value="@SortMode.CreatedDesc">Создано ↓</option>
                        <option value="@SortMode.CreatedAsc">Создано ↑</option>
                        <option value="@SortMode.EndDateAsc">Конец ↑</option>
                        <option value="@SortMode.EndDateDesc">Конец ↓</option>
                    </select>
                </div>

                <div class="col-12 col-lg-1 d-grid">
                    <button class="btn btn-outline-secondary" @onclick="ResetFilters" title="Сбросить">
                        <i class="bi bi-sliders"></i>
                    </button>
                </div>

                <div class="col-12">
                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-2">
                        <!-- Tabs -->
                        <ul class="nav nav-pills">
                            <li class="nav-item">
                                <button class="nav-link @(Tab == MissionTab.All ? "active" : "")"
                                        @onclick="() => SetTab(MissionTab.All)">
                                    All <span class="badge bg-light text-dark ms-1">@AllCount</span>
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(Tab == MissionTab.Planned ? "active" : "")"
                                        @onclick="() => SetTab(MissionTab.Planned)">
                                    Planned <span class="badge bg-light text-dark ms-1">@PlannedCount</span>
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(Tab == MissionTab.Active ? "active" : "")"
                                        @onclick="() => SetTab(MissionTab.Active)">
                                    Active <span class="badge bg-light text-dark ms-1">@ActiveCount</span>
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(Tab == MissionTab.Paused ? "active" : "")"
                                        @onclick="() => SetTab(MissionTab.Paused)">
                                    Paused <span class="badge bg-light text-dark ms-1">@PausedCount</span>
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(Tab == MissionTab.Completed ? "active" : "")"
                                        @onclick="() => SetTab(MissionTab.Completed)">
                                    Completed <span class="badge bg-light text-dark ms-1">@CompletedCount</span>
                                </button>
                            </li>
                        </ul>

                        <!-- View switch -->
                        <div class="btn-group" role="group" aria-label="View">
                            <button class="btn btn-outline-secondary @(View == ViewMode.Cards ? "active" : "")"
                                    @onclick="() => SetView(ViewMode.Cards)">
                                <i class="bi bi-grid-3x3-gap me-1"></i> Cards
                            </button>
                            <button class="btn btn-outline-secondary @(View == ViewMode.Table ? "active" : "")"
                                    @onclick="() => SetView(ViewMode.Table)">
                                <i class="bi bi-table me-1"></i> Table
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Content -->
    @if (IsBusy)
    {
        <div class="alert alert-info d-flex align-items-center" role="alert">
            <div class="spinner-border spinner-border-sm me-2" aria-hidden="true"></div>
            <div>Загружаю миссии…</div>
        </div>
    }
    else if (!Filtered.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="display-6 mb-2">🧭</div>
                <h5 class="mb-1">Ничего не найдено</h5>
                <div class="text-secondary mb-3">Сбрось фильтры или создай новую миссию.</div>
                <div class="d-flex justify-content-center gap-2">
                    <button class="btn btn-outline-secondary" @onclick="ResetFilters">Сбросить</button>
                    <button class="btn btn-primary" @onclick="Create">New mission</button>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (View == ViewMode.Cards)
        {
            <div class="row g-3">
                @foreach (var m in Paged)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 shadow-sm hover-card" role="button" @onclick="() => Open(m.Id)">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="me-2">
                                        <h5 class="card-title mb-1 text-truncate">@m.Title</h5>
                                        <div class="text-secondary small">
                                            <span>@SupervisorLabel(m)</span>
                                            <span class="mx-1">•</span>
                                            <span>@DateRangeLabel(m)</span>
                                        </div>
                                    </div>

                                    <span class="badge @StatusBadgeClass(m.Status)">@m.Status</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(m.Description))
                                {
                                    <p class="card-text text-secondary mt-3 mb-0">
                                        @TrimTo(m.Description!, 140)
                                    </p>
                                }
                            </div>

                            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                                <small class="text-secondary">
                                    Updated: @m.UpdatedTime.ToString("dd MMM HH:mm")
                                </small>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => Edit(m.Id)">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Supervisor</th>
                                <th>Dates</th>
                                <th class="text-end" style="width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Paged)
                            {
                                <tr role="button" @onclick="() => Open(m.Id)">
                                    <td>
                                        <div class="fw-semibold">@m.Title</div>
                                        <div class="text-secondary small">
                                            Created: @m.CreatedTime.ToString("dd MMM yyyy")
                                            <span class="mx-1">•</span>
                                            Updated: @m.UpdatedTime.ToString("dd MMM HH:mm")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @StatusBadgeClass(m.Status)">@m.Status</span>
                                    </td>
                                    <td>@SupervisorLabel(m)</td>
                                    <td>@DateRangeLabel(m)</td>
                                    <td class="text-end" @onclick:stopPropagation="true">
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => Open(m.Id)">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(m.Id)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Pager -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
            <div class="text-secondary small">
                Showing <b>@Paged.Count</b> of <b>@Filtered.Count()</b>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary"
                        @onclick="Prev" disabled="@(Page == 1)">
                    Prev
                </button>

                <span class="badge text-bg-light px-3 py-2">
                    Page @Page / @TotalPages
                </span>

                <button class="btn btn-outline-secondary"
                        @onclick="Next" disabled="@(Page == TotalPages)">
                    Next
                </button>
            </div>
        </div>
    }

</div>

@code
{
    private bool IsBusy { get; set; } = true;

    private string Query { get; set; } = "";
    private string StatusFilter { get; set; } = "";
    private SortMode Sort { get; set; } = SortMode.UpdatedDesc;

    private ViewMode View { get; set; } = ViewMode.Cards;
    private MissionTab Tab { get; set; } = MissionTab.All;

    private int Page { get; set; } = 1;
    private int PageSize { get; set; } = 9; // чуть плотнее под сетку

    private List<BaseMissionDto> Items { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        IsBusy = true;
        StateHasChanged();

        Items = (await MissionService.GetAllAsync()).ToList();

        IsBusy = false;
        ClampPage();
    }

    private void Create() => Nav.NavigateTo("/Missions/Create");
    private void Open(int id) => Nav.NavigateTo($"/Missions/Details/{id}");
    private void Edit(int id) => Nav.NavigateTo($"/Missions/Edit/{id}");

    private void ClearSearch() { Query = ""; Page = 1; }
    private void ResetFilters()
    {
        Query = "";
        StatusFilter = "";
        Sort = SortMode.UpdatedDesc;
        Tab = MissionTab.All;
        Page = 1;
    }

    private void SetView(ViewMode mode) => View = mode;
    private void SetTab(MissionTab tab) { Tab = tab; Page = 1; }

    private void Prev() { if (Page > 1) Page--; }
    private void Next() { if (Page < TotalPages) Page++; }

    private IEnumerable<BaseMissionDto> Filtered
    {
        get
        {
            IEnumerable<BaseMissionDto> q = Items;

            q = Tab switch
            {
                MissionTab.Planned => q.Where(x => x.Status == MissionStatus.Planned),
                MissionTab.Active => q.Where(x => x.Status == MissionStatus.Active),
                MissionTab.Paused => q.Where(x => x.Status == MissionStatus.Paused),
                MissionTab.Completed => q.Where(x => x.Status == MissionStatus.Completed),
                _ => q
            };

            if (!string.IsNullOrWhiteSpace(Query))
            {
                var s = Query.Trim().ToLowerInvariant();
                q = q.Where(x =>
                    (x.Title?.ToLowerInvariant().Contains(s) ?? false) ||
                    (x.Description?.ToLowerInvariant().Contains(s) ?? false) ||
                    (x.Supervisor?.ToString()?.ToLowerInvariant().Contains(s) ?? false) ||
                    (x.SupervisorId?.ToLowerInvariant().Contains(s) ?? false));
            }

            if (!string.IsNullOrWhiteSpace(StatusFilter) && Enum.TryParse<MissionStatus>(StatusFilter, out var st))
                q = q.Where(x => x.Status == st);

            q = Sort switch
            {
                SortMode.UpdatedAsc => q.OrderBy(x => x.UpdatedTime),
                SortMode.CreatedDesc => q.OrderByDescending(x => x.CreatedTime),
                SortMode.CreatedAsc => q.OrderBy(x => x.CreatedTime),
                SortMode.EndDateAsc => q.OrderBy(x => x.EndDate ?? DateTime.MaxValue),
                SortMode.EndDateDesc => q.OrderByDescending(x => x.EndDate ?? DateTime.MinValue),
                _ => q.OrderByDescending(x => x.UpdatedTime)
            };

            return q.ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtered.Count() / (double)PageSize));
    private List<BaseMissionDto> Paged => Filtered.Skip((Page - 1) * PageSize).Take(PageSize).ToList();

    private void ClampPage()
    {
        if (Page > TotalPages) Page = TotalPages;
        if (Page < 1) Page = 1;
    }

    private int AllCount => Items.Count;
    private int PlannedCount => Items.Count(x => x.Status == MissionStatus.Planned);
    private int ActiveCount => Items.Count(x => x.Status == MissionStatus.Active);
    private int PausedCount => Items.Count(x => x.Status == MissionStatus.Paused);
    private int CompletedCount => Items.Count(x => x.Status == MissionStatus.Completed);

    private static string SupervisorLabel(BaseMissionDto m)
        => m.SupervisorId is null ? "—" : (m.Supervisor?.ToString() ?? $"ID: {m.SupervisorId}");

    private static string DateRangeLabel(BaseMissionDto m)
    {
        var s = m.StartDate?.ToString("dd MMM yyyy") ?? "—";
        var e = m.EndDate?.ToString("dd MMM yyyy") ?? "—";
        return $"{s} → {e}";
    }

    private static string TrimTo(string s, int max)
        => s.Length <= max ? s : s.Substring(0, max).Trim() + "…";

    private static string StatusBadgeClass(MissionStatus s) => s switch
    {
        MissionStatus.Planned => "bg-info text-dark",
        MissionStatus.Active => "bg-success",
        MissionStatus.Paused => "bg-warning text-dark",
        MissionStatus.Completed => "bg-secondary",
        _ => "bg-secondary"
    };

    private enum ViewMode { Cards, Table }
    private enum MissionTab { All, Planned, Active, Paused, Completed }
    private enum SortMode { UpdatedDesc, UpdatedAsc, CreatedDesc, CreatedAsc, EndDateAsc, EndDateDesc }
}
