@page "/Missions/Details/{MissionId:int}"
@attribute [Authorize(Roles = "Admin,General,Supervisor")]

@using Microsoft.AspNetCore.Authorization
@using QazaqGeoReports.Application.DTOs.MissionDtos
@using QazaqGeoReports.Application.DTOs.UserDtos
@using QazaqGeoReports.Application.Interfaces.Services

@inject NavigationManager Nav
@inject IMissionService MissionService 
@inject IUserService UserService

<PageTitle>Mission details</PageTitle>

<div class="dm-page">

    <div class="dm-topbar">
        <button class="btn btn-sm btn-outline-secondary rounded-pill" @onclick="GoBack">
            <i class="bi bi-arrow-left me-2"></i>Назад
        </button>

        <div class="dm-actions">
            <button class="btn btn-sm btn-outline-primary rounded-pill"
                    @onclick="GoEdit"
                    disabled="@(!_loaded || _mission is null)">
                <i class="bi bi-pencil-square me-2"></i>Редактировать
            </button>
        </div>
    </div>

    @if (!_loaded)
    {
        <div class="dm-card card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="spinner-border" role="status" aria-label="Loading"></div>
                    <div>
                        <div class="fw-semibold">Загружаю миссию…</div>
                        <div class="text-muted small">База данных медитирует. Мы не мешаем.</div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_mission is null)
    {
        <div class="dm-card card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="dm-icon-badge">
                        <i class="bi bi-question-circle"></i>
                    </div>
                    <div>
                        <div class="h5 mb-1">Миссия не найдена</div>
                        <div class="text-muted mb-3">Возможно, её удалили или ID неверный.</div>
                        <button class="btn btn-primary rounded-pill" @onclick="GoBack">
                            <i class="bi bi-grid me-2"></i>К списку миссий
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="dm-header card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                    <div class="min-w-0">
                        <div class="dm-kicker text-muted small mb-1">
                            Mission #@_mission.Id
                        </div>

                        <div class="dm-title h3 mb-2 text-truncate">
                            @_mission.Title
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_mission.Description))
                        {
                            <div class="text-muted dm-desc">@_mission.Description</div>
                        }
                        else
                        {
                            <div class="text-muted dm-desc fst-italic">Описание не задано.</div>
                        }
                    </div>

                    <div class="text-end">
                        <span class="badge rounded-pill dm-status @StatusClass(_mission.Status.ToString())">
                            <i class="bi bi-activity me-1"></i>@_mission.Status
                        </span>
                        <div class="text-muted small mt-2">
                            Период: @FormatRange(_mission.StartDate, _mission.EndDate)
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="dm-meta">
                            <div class="dm-meta-label">Супервайзер</div>
                            <div class="dm-meta-value">
                                    @(_supervisor?.FullName ?? "—")
                            </div> 
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="dm-meta">
                            <div class="dm-meta-label d-flex align-items-center justify-content-between">
                                @* <span>Workers (string)</span>
                                <span class="badge text-bg-light">@_workersTokens.Count</span> *@
                            </div>

                            @if (string.IsNullOrWhiteSpace(""))
                            {
                                <div class="text-muted fst-italic">Пусто.</div>
                            }
                            else
                            {
                                @* <div class="dm-workers-raw text-muted small mb-2">
                                    @_mission.Workers
                                </div> *@

                                <div class="dm-chips">
                                    @foreach (var w in _workers)
                                    {
                                        <span class="badge rounded-pill text-bg-light dm-chip">
                                            <i class="bi bi-person me-1"></i>@w.FullName
                                        </span>
                                    }
                                </div>
@* 
                                <div class="dm-hint text-muted small mt-2">
                                    Поддерживаем разделители: <code>,</code> <code>;</code> <code>|</code> и перенос строки.
                                </div> *@
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger mt-3 mb-0 rounded-4">
                <i class="bi bi-exclamation-triangle me-2"></i>@_error
            </div>
        }
    }
</div>

@code {
    [Parameter] public int MissionId { get; set; }

    private bool _loaded;
    private string? _error;

    private BaseMissionDto _mission; 

    private List<string> _workersTokens = new();
    private List<BaseUserDto> _workers = new();
    private BaseUserDto _supervisor = new();

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _loaded = false;
        _error = null;

        try
        { 
            var m = await MissionService.GetByIdAsync(MissionId);
            _mission = m;

            _workersTokens = ParseWorkers("");
            foreach(var item in _workersTokens)
            {
                _workers.Add(await UserService.GetUserByIdAsync(item));
            }
            _supervisor = await UserService.GetUserByIdAsync(_mission?.SupervisorId);
        }
        catch (Exception ex)
        {
            _error = $"Ошибка загрузки: {ex.Message}";
            _mission = null;
            _workersTokens = new(); 
            _supervisor = new();
        }
        finally
        {
            _loaded = true;
        }
    }

    private void GoBack() => Nav.NavigateTo("/Missions");

    private void GoEdit()
    {
        if (_mission is null) return;
        Nav.NavigateTo($"/Missions/Edit/{_mission.Id}");
    }

    private static string FormatRange(DateTime? start, DateTime? end)
    {
        var s = start.HasValue ? start.Value.ToString("dd.MM.yyyy") : "—";
        var e = end.HasValue ? end.Value.ToString("dd.MM.yyyy") : "—";
        return $"{s} → {e}";
    }

    private static string StatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "planned" => "dm-badge-planned",
            "inprogress" => "dm-badge-progress",
            "completed" => "dm-badge-done",
            "canceled" => "dm-badge-canceled",
            _ => "dm-badge-default"
        };
    }
     
    private static List<string> ParseWorkers(string? workers)
    {
        if (string.IsNullOrWhiteSpace(workers))
            return new();

        var split = workers
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

        return split;
    }

}
